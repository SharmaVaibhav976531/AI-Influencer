# ==========================================
# Django Security & Core Settings
# ==========================================
SECRET_KEY=django-insecure-your-secret-key-goes-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Database
DB_NAME=influencer_db
DB_USER=influencer_user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432


# Real-Time Discovery Configuration
DISCOVERY_ENABLED=True
DEFAULT_PROVIDER=mock
DISCOVERY_TIMEOUT=30
MAX_DISCOVERY_RESULTS=5

# Future Provider Keys (Placeholders)
INSTAGRAM_API_KEY=
YOUTUBE_API_KEY=
LINKEDIN_API_KEY=
TWITTER_API_KEY=

# ==========================================
# OpenRouter AI Configuration
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_RETRIES=3

# ==========================================
# Static & Media Storage Settings
# ==========================================
STATIC_ROOT=staticfiles
MEDIA_ROOT=media